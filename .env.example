# App
NODE_ENV=development
PORT=3000
PUBLIC_URL=https://YOUR-DOMAIN.example

# Telegram
BOT_TOKEN=123456:REPLACE_ME
BOT_USERNAME=YourVTONBot

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vton?schema=public

# TON
TON_NETWORK=testnet
TONCENTER_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=
VTON_JETTON_MASTER=EQ_REPLACE_WITH_YOUR_VTON_JETTON_MASTER
VTON_DECIMALS=9
# Space-separated mnemonic for a dedicated treasury wallet. NEVER commit this.
TREASURY_MNEMONIC=

# Mining economics
MINING_RATE_PER_SECOND=0.00001
REFERRAL_PERCENT=0.10
MIN_CLAIM=1
CLAIM_FEE_VTON=0

# Optional admin
ADMIN_TELEGRAM_ID=0